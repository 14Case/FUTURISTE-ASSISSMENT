# ==============================================================================
# FUTURISTE ASSESSMENT — Variables d'environnement (exemple sans secrets)
# Copiez ce fichier vers .env.local en développement et renseignez les valeurs
# dans Vercel > Settings > Environment Variables en production.
# ==============================================================================

# URL publique du projet Supabase (ex: https://xyzcompany.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Clé publique "anon" (ou "publishable") Supabase — sécurisée par les politiques RLS
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé privée "service_role" Supabase — STRICTEMENT CÔTÉ SERVEUR
# Ne JAMAIS préfixer par NEXT_PUBLIC_. Utilisée uniquement côté serveur pour :
#   - la création de comptes encadreurs par un administrateur (Auth Admin API)
#   - l'amorçage initial du tout premier compte administrateur
SUPABASE_SERVICE_ROLE_KEY=

# URL publique de l'application (ex: http://localhost:3000 ou https://assessment.futuriste-fc.org)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Jeton secret optionnel permettant de créer le tout premier compte ADMIN
# via /initialisation lorsqu'aucun administrateur n'existe encore en base.
# Désactivez ou supprimez cette variable une fois le premier compte ADMIN créé.
BOOTSTRAP_ADMIN_SECRET=
